# Copy to .env for development. .env is git-ignored.
#
# Pick ONE of the two setups below. To share a single database while testing, only one person (the host)
# runs the server; everyone else runs a terminal that connects to the host's PC over Tailscale or the LAN.

# ---------------------------------------------------------------------------
# A) HOST: the one PC that owns the database (run scripts\lan-setup.ps1 -Tailscale as administrator first)
# ---------------------------------------------------------------------------
# Which role this PC plays: server | terminal | unconfigured
APP_MODE=server
# Terminal PCs only: PC-01, PC-02 or PC-03
TERMINAL_ID=
# Terminal PCs only: address of the server PC (never hardcoded in code)
SERVER_HOST=127.0.0.1
API_PORT=4010

# Server PC only: MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=GroceryApp!
DB_PASSWORD=MyPassword123!
DB_NAME=grocery9010

# First run only: owner PIN (6 digits) and whether to load database/sample-data.sql
LOAD_SAMPLE_DATA=true

# Server PC only: Python for the ML service. Empty = ml_service/.venv (from npm run ml:install)
ML_PYTHON=

# ---------------------------------------------------------------------------
# B) COLLABORATOR (development testing only): connect to the host's data instead of making your own.
#    This uses Tailscale, which needs internet. In the store there is no Tailscale: SERVER_HOST is the server PC's
#    local network IP and everything works offline.
#    Use these values INSTEAD of the server ones above (do not also run a server; it would create a second database):
#
#    APP_MODE=terminal
#    TERMINAL_ID=PC-02              # a terminal the host added in Admin Station; one PC per ID
#    SERVER_HOST=100.x.y.z          # the host's Tailscale address (the host's lan-setup.ps1 -Tailscale prints it)
#    API_PORT=4010
#
#    The DB_* and ML_PYTHON settings are not needed. Check the link first:
#    http://<SERVER_HOST>:4010/api/health should load in your browser.
#
#    Browser-only dev (npm run dev, no Electron): set VITE_API_BASE_URL=http://100.x.y.z:4010 in .env instead.
# ---------------------------------------------------------------------------
